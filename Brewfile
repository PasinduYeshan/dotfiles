# Install everything with: brew bundle --file=~/project/personal/dotfiles/Brewfile

# Shell
brew "zsh-autosuggestions"     # grey suggestions from history (→ to accept)
brew "zsh-syntax-highlighting" # colours commands as you type
brew "zoxide"                  # `z <part>` jumps to remembered folders, Tab lists them
brew "fzf"                     # fuzzy finder (Ctrl-T files, Alt-C folders, fzf-tab)
brew "atuin"                   # searchable shell history on Ctrl-R
brew "yazi"                    # terminal file manager, `y`
brew "poppler"                 # PDF previews in yazi
brew "sevenzip"                # archive previews in yazi

# CLI tools
brew "bat"         # cat with syntax highlighting
brew "eza"         # ls replacement (`lt` tree alias)
brew "fd"          # fast find
brew "ripgrep"     # fast grep (rg)
brew "jq"
brew "tree"
brew "wget"
brew "ncdu"        # disk usage browser (`du1`)
brew "tlrc"        # tldr pages
brew "neovim"

# Git
brew "gh"
brew "git-delta"   # diff pager, configured in git/.gitconfig
brew "lazygit"     # `lg`

# Languages
brew "nvm"         # Node: `nvm install` inside a repo with .nvmrc
brew "python@3.15"
brew "go"

# Apps
cask "visual-studio-code" # settings come back through VS Code Settings Sync
cask "iterm2"
cask "rancher"            # Rancher Desktop: docker + kubectl
cask "claude-code"        # `claude`, `cdesk` opens a folder in the desktop app
cask "codex"
